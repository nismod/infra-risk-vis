# Data for the metrics-load service (docker-compose-dev.yaml, profile `metrics`).
# Compose reads these from the shell or from a `.env` file next to the compose
# file (copy this file there as `.env`, or `export` the variables).
#
# Published metric CSVs: one directory per country (KEN/, MOZ/, ...)
METRICS_DATA_DIR=./metrics-data
# CGAZ boundaries: geoBoundariesCGAZ_ADM0.gpkg, _ADM1.gpkg, _ADM2.gpkg
# (default: $METRICS_DATA_DIR/boundaries/cgaz)
METRICS_CGAZ_DIR=./metrics-data/boundaries/cgaz
