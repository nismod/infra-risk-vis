import os
import subprocess
import sys

import geopandas
import pandas


# Example config
configfile: "pipelines/osm_rail/config.yml"


# Read further configuration data from CSV
network_layers = pandas.read_csv(config["network_layers"])
network_tilelayers = pandas.read_csv(config["network_tilelayers"])

# open-gira results: with open_gira_results.run (or an existing lock) set, the
# network layers listed with an og_layer in network_layers.csv are fetched from
# the published run {BASE}/results/open-gira/{run}/ with the irv-datapkg
# client, to raw_data/open-gira/{run}/{ref}.geoparquet (one file: exactly
# one item must match the row's og_filters).
# Otherwise each layer's `path` is read as before.
# See etl/README.md "Vector layers from open-gira results".
sys.path.insert(0, os.path.join(workflow.basedir, "..", "..", "scripts"))
import og_results

OG_RESULTS = og_results.results_config(config)
OG_SINGLE = True


def network_source(wildcards):
    """Input of networks_to_db: the fetched results layer, if configured."""
    tile_layer = get_tilelayer(wildcards.layer, network_tilelayers)
    row = network_layers[network_layers.ref == tile_layer.ref].iloc[0]
    if og_results.active(OG_RESULTS) and isinstance(row.get("og_layer"), str):
        return {"source": og_results.fetched_path(OG_RESULTS, row.ref, OG_SINGLE)}
    return {}


wildcard_constraints:
    layer="[^/]+",


# Run all file-base jobs, after load_to_database
rule all:
    input:
        expand(
            "vector/data/{layer}.mbtiles", layer=network_tilelayers.layer
        ),
        expand(
            "logs/network/{layer}.txt", layer=network_tilelayers.layer
        ),
        expand(
            "vector/{layer}.geojsonl", layer=network_tilelayers.layer
        ),


rule networks_to_db:
    """Read from source directory to database
    """
    input:
        unpack(network_source),
    output:
        "logs/network/{layer}.txt",
    script:
        "osm_rail_to_db.py"


if og_results.active(OG_RESULTS):

    rule fetch_og_results:
        """Fetch a network layer from the published open-gira results run
        (sha256-verified; through the results lock if configured)."""
        input:
            lock=[OG_RESULTS["lock"]] if OG_RESULTS["lock"] and os.path.exists(OG_RESULTS["lock"]) else [],
        output:
            og_results.fetched_path(OG_RESULTS, "{ref}", OG_SINGLE),
        wildcard_constraints:
            ref="[^/]+",
        params:
            row=lambda wildcards: network_layers[network_layers.ref == wildcards.ref].iloc[0].to_dict(),
        run:
            catalog = og_results.open_run(OG_RESULTS)
            og_results.fetch_layer(
                catalog,
                params.row["og_layer"],
                output[0],
                filters=params.row.get("og_filters"),
                single=OG_SINGLE,
                cache=og_results.use_cache(OG_RESULTS),
            )

rule db_to_geojsonseq:
    """Load from database to GeoJSONSeq
    """
    input:
        "logs/network/{layer}.txt",
    output:
        "vector/{layer}.geojsonl",
    script:
        "../../scripts/db_to_geojsonseq.py"


rule geojsonseq_to_vector_tiles:
    input:
        "vector/{layer}.geojsonl",
    output:
        "vector/data/{layer}.mbtiles",
    run:
        layer = get_tilelayer(wildcards.layer, network_tilelayers)

        max_zoom = 20
        point_polygon_zoom_switch = 13

        if layer.spatial_type == "line":
            options = [
                "--minimum-zoom=4",
                "-zg",
                "--coalesce-densest-as-needed",
                "--extend-zooms-if-still-dropping",
                "--simplification=10",
                f"--simplify-only-low-zooms",
            ]
        elif layer.spatial_type == "polygon":
            options = [
                "--drop-smallest-as-needed",
                f"--minimum-zoom={point_polygon_zoom_switch}",
                f"--maximum-zoom={max_zoom}",
            ]
        else:
            options = [
                "--drop-densest-as-needed",
                "-Bg",
                f"--maximum-zoom={max_zoom}",
                "--full-detail=12"
            ]

        subprocess.run(
            [
                "tippecanoe",
                "--use-attribute-for-id=uid",
                "--read-parallel",
                f"--output={output}",
                f"--layer={wildcards.layer}",
            ]
            + options
            + ["--force", f"{input}"],
            check=True
        )


def get_tilelayer(layer_name, network_tilelayers):
    try:
        return network_tilelayers[network_tilelayers.layer == layer_name].iloc[0]
    except IndexError as e:
        print(f"Could not find {layer_name} in tilelayers.")
        raise e
